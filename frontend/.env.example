# Optional deep links for the inspector's "Source & logs" buttons.
# Placeholders: {id} {label} {cluster} {owner} {region} {version}
# Unset = Logs/Traces/Runbook open the in-app simulated viewer; Source code stays disabled.
VITE_LOGS_URL=
VITE_TRACES_URL=
VITE_SOURCE_URL=
VITE_RUNBOOK_URL=
# Examples:
# VITE_LOGS_URL=https://grafana.example.com/explore?query={id}
# VITE_SOURCE_URL=https://github.com/your-org/{id}
